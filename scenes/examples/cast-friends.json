  "camera": [ { "t": 0, "do": "follow", "who": ["pip", "bluey", "star", "square"], "subject_width": 0.5, "lag": 0.08, "offset": [0, 80] } ],
  "length": { "seconds": 5 },
  "capture_only": [],
  "vary": { "input_jitter": 0.08 },
