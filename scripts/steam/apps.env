# Steam apps this pipeline can upload to (copied from tankii-worlds/scripts/steam/apps.env).
# Depot ids are explicit. EMPTY = "no depot yet": upload.sh then drops that
# platform's content with a note instead of inventing an id.
#
# Override any value in the environment (STEAM_MAIN_DEPOT_MACOS=… etc).
#
# What Steam shows for 4485010 (2026-10-17, `steamcmd +login acitozzul
# +app_info_print 4485010`): ONE depot, 4485011, with no config (no oslist)
# and no manifests or branches yet; launch option "game.exe". So today only a
# Windows depot can be guessed, and only once Sterling sets its OS to Windows
# (a depot with no oslist is downloaded on EVERY platform). macOS and Linux
# depots don't exist yet; see docs/Release.md "Steamworks setup".

STEAM_MAIN_APP_ID="${STEAM_MAIN_APP_ID:-4485010}"
STEAM_MAIN_DEPOT_WINDOWS="${STEAM_MAIN_DEPOT_WINDOWS:-4485011}"
STEAM_MAIN_DEPOT_MACOS="${STEAM_MAIN_DEPOT_MACOS:-}"
STEAM_MAIN_DEPOT_LINUX="${STEAM_MAIN_DEPOT_LINUX:-}"

# Bouncy Blobs demo: Sterling is creating the app. Empty = skip the demo upload.
STEAM_DEMO_APP_ID="${STEAM_DEMO_APP_ID:-}"
STEAM_DEMO_DEPOT_WINDOWS="${STEAM_DEMO_DEPOT_WINDOWS:-}"
STEAM_DEMO_DEPOT_MACOS="${STEAM_DEMO_DEPOT_MACOS:-}"
STEAM_DEMO_DEPOT_LINUX="${STEAM_DEMO_DEPOT_LINUX:-}"

# The builder account (same as tankii) and its throwaway HOME with the cached
# Steam Guard login (never the Steam client's own config, never Sterling's account).
STEAM_USERNAME="${STEAM_USERNAME:-acitozzul}"
STEAM_HOME="${STEAM_HOME:-$HOME/.steam-builder}"
